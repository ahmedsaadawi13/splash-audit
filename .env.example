# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=splash_audit
DB_USER=root
DB_PASS=

# Application Settings
APP_NAME=SplashAudit
APP_ENV=development
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Security
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,docx,xlsx,jpg,jpeg,png

# Email Configuration (Simulated)
MAIL_FROM_ADDRESS=noreply@splashaudit.com
MAIL_FROM_NAME=SplashAudit

# Platform Settings
PLATFORM_ADMIN_EMAIL=admin@splashaudit.com
DEFAULT_SUBSCRIPTION_PLAN=basic

# API Settings
API_RATE_LIMIT=100
