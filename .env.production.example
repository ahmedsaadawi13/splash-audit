# Production Environment Configuration
# Copy this file to .env and update values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_KEY=GENERATE-SECURE-64-CHAR-KEY-WITH-bin2hex-random_bytes-32

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=splash_audit_prod
DB_USER=splashuser
DB_PASS=CHANGE-THIS-STRONG-PASSWORD

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-specific-password
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=SplashAudit

# Session
SESSION_LIFETIME=120
SESSION_SECURE=true

# Security
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=5

# File Upload
MAX_UPLOAD_SIZE=20971520
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif

# Backup
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/splashaudit

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=error

# Cache (optional - if using Redis)
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Queue (optional - for future)
QUEUE_DRIVER=sync
