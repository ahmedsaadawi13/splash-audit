# Environment file
.env

# Storage directories
storage/uploads/*
!storage/uploads/.gitkeep
storage/logs/*
!storage/logs/.gitkeep

# Vendor directory (if using Composer)
vendor/

# Composer lock file (uncomment to ignore)
# composer.lock

# IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Cache
storage/cache/*
!storage/cache/.gitkeep

# Temporary files
*.tmp
*.temp
*.log

# Uploaded files (keep structure, ignore content)
public/uploads/*
!public/uploads/.gitkeep
